{
  "name": "@horizon-republic/nestjs-jetstream",
  "version": "2.13.0",
  "description": "A NestJS transport for NATS with JetStream events, broadcast fan-out, and Core/JetStream RPC.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HorizonRepublic/nestjs-jetstream.git"
  },
  "homepage": "https://nestjs-jetstream.horizon-republic.dev/",
  "bugs": {
    "url": "https://github.com/HorizonRepublic/nestjs-jetstream/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "jetstream",
    "nats",
    "transport",
    "microservices",
    "rpc",
    "events"
  ],
  "author": {
    "name": "Horizon Republic",
    "url": "https://github.com/HorizonRepublic"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 20.0.0",
    "pnpm": ">= 11.17.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt \"{src,test,examples,tools}/**/*.{ts,mjs}\" \"website/docs/**/*.md\" \"examples/**/*.md\" README.md",
    "format:check": "oxfmt --check \"{src,test,examples,tools}/**/*.{ts,mjs}\" \"website/docs/**/*.md\" \"examples/**/*.md\" README.md",
    "start:example": "pnpm build && tsx --tsconfig examples/tsconfig.json examples/01-basic/main.ts",
    "dev:example": "tsx --tsconfig examples/tsconfig.json examples/01-basic/main.ts",
    "prepublishOnly": "pnpm build",
    "lint": "oxlint --type-aware",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:fix": "oxlint --type-aware --fix",
    "docs:api": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 -p typedoc-plugin-markdown@4.12.0 typedoc && node tools/seo/noindex-generated-docs.mjs",
    "docs:dev": "pnpm docs:api && pnpm --filter ./website start",
    "docs:build": "pnpm docs:api && pnpm --filter ./website build",
    "docs:serve": "pnpm --filter ./website serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "bench": "node --expose-gc --import tsx benchmarks/harness/cli.ts",
    "bench:codec": "pnpm bench codec",
    "bench:route": "pnpm bench route-pipeline",
    "bench:all": "pnpm bench all",
    "bench:quick": "pnpm bench all --quick",
    "bench:diff": "node --import tsx benchmarks/harness/diff-cli.ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.2.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.2.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^10.2.0 || ^11.0.0 || ^12.0.0",
    "@opentelemetry/api": "^1.9.0",
    "msgpackr": "^1.11.0 || ^2.0.0",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "msgpackr": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@golevelup/ts-vitest": "^4.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "hdr-histogram-js": "^3.0.1",
    "markdownlint-cli2": "^0.23.1",
    "msgpackr": "^2.0.4",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prom-client": "^15.1.3",
    "testcontainers": "^12.0.4",
    "tinybench": "^6.1.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nuid": "^3.0.0",
    "@nats-io/transport-node": "^3.4.0"
  }
}
