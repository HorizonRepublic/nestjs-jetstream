{
  // oxfmt owns whitespace, line length, list markers and table alignment.
  // What stays on is what a formatter cannot see: document structure, link
  // integrity, and code fences that would render without highlighting.
  "config": {
    "MD013": false, // line length
    "MD004": false, // list marker style
    "MD007": false, // list indent
    "MD012": false, // consecutive blank lines
    "MD033": false, // inline HTML: MDX components live in these pages
    "MD041": false, // first line in file: front matter comes first

    // Docusaurus renders `title` from front matter, so the `#` heading below
    // it is the only h1 the reader sees.
    "MD025": { "front_matter_title": "" },

    // Release notes repeat "New features" under each version heading.
    "MD024": { "siblings_only": true },

    // The same page intentionally uses bold labels inside version entries
    // rather than headings, to keep the table of contents readable.
    "MD036": false
  },
  "globs": ["website/docs/**/*.md", "README.md", "examples/**/*.md"],
  "ignores": [
    // Generated by TypeDoc on every build; fix the generator, not the output.
    "website/docs/reference/api/**",
    "**/node_modules/**"
  ]
}
